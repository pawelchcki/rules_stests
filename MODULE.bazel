# Emit the final service-test result after shutdown, avoiding a second remote
# action for fallback XML. Keep this patch pinned until rules_itest ships it.
single_version_override(
    module_name = "rules_itest",
    patch_strip = 1,
    patches = ["//bazel:rules_itest_junit.patch"],
    version = "0.0.59",
)

# No `name =` here: rules_go rejects a named SDK in a non-root module, which
# would break importing this module as a dependency.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.25.0")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//fixtures/apps/go/telemetry-lab:go.mod")
use_repo(
    go_deps,
    "io_opentelemetry_go_otel",
    "io_opentelemetry_go_otel_exporters_otlp_otlptrace_otlptracehttp",
    "io_opentelemetry_go_otel_metric",
    "io_opentelemetry_go_otel_sdk",
    "io_opentelemetry_go_otel_sdk_metric",
    "io_opentelemetry_go_otel_trace",
)

rust_toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
rust_toolchains.toolchain(
    edition = "2024",
    version = "1.97.1",
)
use_repo(rust_toolchains, "default_rust_toolchains")

register_toolchains(
    "@default_rust_toolchains//...",
    "@llvm//toolchain:all",
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.12")
use_repo(python, "python_3_12")

register_toolchains("@python_3_12//:all")

