module(
    name = "rules_stests_corpus",
    version = "0.0.0",
)

bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "rules_itest", version = "0.0.59")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_rs", version = "0.0.102")
bazel_dep(name = "llvm", version = "0.8.17")
bazel_dep(name = "aspect_bazel_lib", version = "2.21.1")
bazel_dep(name = "package_metadata", version = "0.0.7")
bazel_dep(name = "platforms", version = "1.1.0")

# No `name =` here: rules_go rejects a named SDK in a non-root module, which
# would break importing this module as a dependency.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.25.0")

rust_toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
rust_toolchains.toolchain(
    edition = "2024",
    version = "1.97.1",
)
use_repo(rust_toolchains, "default_rust_toolchains")

register_toolchains(
    "@default_rust_toolchains//:all",
    "@llvm//toolchain:all",
)

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lock = "//bazel/itest:Cargo.lock",
    cargo_toml = "//bazel/itest:Cargo.toml",
    platform_triples = ["x86_64-unknown-linux-gnu"],
)
crate.annotation(
    crate = "serde",
    repositories = ["crates"],
    rustc_flags = ["-Copt-level=3"],
    version = "1.0.229",
)
crate.annotation(
    crate = "serde_core",
    repositories = ["crates"],
    rustc_flags = ["-Copt-level=3"],
    version = "1.0.229",
)
crate.annotation(
    crate = "serde_json",
    repositories = ["crates"],
    rustc_flags = ["-Copt-level=3"],
    version = "1.0.151",
)
crate.annotation(
    crate = "prost",
    repositories = ["crates"],
    rustc_flags = ["-Copt-level=3"],
    version = "0.14.4",
)
crate.annotation(
    crate = "stak-device",
    repositories = ["crates"],
    rustc_flags = ["-Copt-level=3"],
    version = "0.12.23",
)
crate.annotation(
    crate = "stak-file",
    repositories = ["crates"],
    rustc_flags = ["-Copt-level=3"],
    version = "0.12.23",
)
crate.annotation(
    crate = "stak-inexact",
    repositories = ["crates"],
    rustc_flags = ["-Copt-level=3"],
    version = "0.12.23",
)
crate.annotation(
    crate = "stak-lzss",
    repositories = ["crates"],
    rustc_flags = ["-Copt-level=3"],
    version = "0.12.23",
)
crate.annotation(
    crate = "stak-native",
    repositories = ["crates"],
    rustc_flags = ["-Copt-level=3"],
    version = "0.12.23",
)
crate.annotation(
    crate = "stak-process-context",
    repositories = ["crates"],
    rustc_flags = ["-Copt-level=3"],
    version = "0.12.23",
)
crate.annotation(
    crate = "stak-r7rs",
    repositories = ["crates"],
    rustc_flags = ["-Copt-level=3"],
    version = "0.12.23",
)
crate.annotation(
    crate = "stak-time",
    repositories = ["crates"],
    rustc_flags = ["-Copt-level=3"],
    version = "0.12.23",
)
crate.annotation(
    crate = "stak-util",
    repositories = ["crates"],
    rustc_flags = ["-Copt-level=3"],
    version = "0.12.23",
)
crate.annotation(
    crate = "stak-vm",
    repositories = ["crates"],
    rustc_flags = ["-Copt-level=3"],
    version = "0.12.23",
)
use_repo(crate, "crates")

# Images used by the shared harness: external consumers get these too.
corpus_images = use_extension("//bazel:oci_deps.bzl", "oci_deps")
use_repo(
    corpus_images,
    "hurl_tool",
    "hurl_tool_linux_amd64",
    "otel_python",
    "otel_python_linux_amd64",
    "otel_ruby",
    "otel_ruby_linux_amd64",
)

# Images used only by //bazel/itest/apps, this repo's own reference services.
dev_corpus_images = use_extension(
    "//bazel:oci_deps.bzl",
    "oci_deps",
    dev_dependency = True,
)
use_repo(
    dev_corpus_images,
    "aiohttp_realworld",
    "aiohttp_realworld_linux_amd64",
    "django_ninja_realworld",
    "django_ninja_realworld_linux_amd64",
    "gin_realworld",
    "gin_realworld_linux_amd64",
    "rails_realworld",
    "rails_realworld_linux_amd64",
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "cloudflared_linux_amd64",
    downloaded_file_path = "cloudflared",
    executable = True,
    sha256 = "fcfb02b575a52ca1af2e3267af4e1517bcdeb30ac48c834c69abaed3c0576ad2",
    urls = ["https://github.com/cloudflare/cloudflared/releases/download/2026.8.2/cloudflared-linux-amd64"],
)

http_file(
    name = "cloudflared_linux_arm64",
    downloaded_file_path = "cloudflared",
    executable = True,
    sha256 = "7747d94570fb390cf47dcb4f9555c193c6355cda9793f0d878d9049e5d6a7790",
    urls = ["https://github.com/cloudflare/cloudflared/releases/download/2026.8.2/cloudflared-linux-arm64"],
)

http_archive(
    name = "cloudflared_darwin_amd64",
    build_file_content = "exports_files([\"cloudflared\"])\n",
    # Cloudflare publishes b0f770... as the extracted binary's checksum.
    sha256 = "f1727723c586500e2092368ae21871b3df7ddfd2cb097f22d81bee4a9c458bb4",
    urls = ["https://github.com/cloudflare/cloudflared/releases/download/2026.8.2/cloudflared-darwin-amd64.tgz"],
)

http_archive(
    name = "cloudflared_darwin_arm64",
    build_file_content = "exports_files([\"cloudflared\"])\n",
    # Cloudflare publishes b61054... as the extracted binary's checksum.
    sha256 = "9042c2c5d8b2de78e60f313d5fb31b6c5c1cebde787a3caf1f2c9588084ac442",
    urls = ["https://github.com/cloudflare/cloudflared/releases/download/2026.8.2/cloudflared-darwin-arm64.tgz"],
)

http_file(
    name = "cloudflared_windows_amd64",
    downloaded_file_path = "cloudflared.exe",
    executable = True,
    sha256 = "c29eee2b121f5436a642eed69fd9767da7e7b8c510fa50aaa130337f931357b5",
    urls = ["https://github.com/cloudflare/cloudflared/releases/download/2026.8.2/cloudflared-windows-amd64.exe"],
)

http_archive(
    name = "stak_compiler_assets",
    build_file_content = """
package(default_visibility = ["//visibility:public"])

filegroup(name = "compiler_bytecode", srcs = ["src/compile.bc"])
filegroup(name = "prelude", srcs = ["src/prelude.scm"])
""",
    sha256 = "e69f89d14ef15e24ce0678ce09c8608f97bed8e97cdd0a9fcf7ce2476a0f0b24",
    strip_prefix = "stak-compiler-0.12.23",
    type = "tar.gz",
    urls = ["https://static.crates.io/crates/stak-compiler/stak-compiler-0.12.23.crate"],
)

http_archive(
    name = "realworld_api_specs",
    build_file_content = """
package(default_visibility = ["//visibility:public"])

filegroup(
    name = "hurl_all",
    srcs = glob(["hurl/*.hurl"]),
)

""",
    sha256 = "a020323e935d1185e8f8a6f64317e6346b44cb0b037d991ec45df89fb7a12adc",
    strip_prefix = "realworld-5d510ce6ec41bb97723e92fbd8d3e3458a381c09/specs/api",
    urls = ["https://github.com/realworld-apps/realworld/archive/5d510ce6ec41bb97723e92fbd8d3e3458a381c09.tar.gz"],
)
