module(
    name = "rules_stests_corpus",
    version = "0.0.0",
)

bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "rules_itest", version = "0.0.59")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_rs", version = "0.0.102")
bazel_dep(name = "llvm", version = "0.8.17")
bazel_dep(name = "aspect_bazel_lib", version = "2.21.1")
bazel_dep(name = "package_metadata", version = "0.0.7")
bazel_dep(name = "platforms", version = "1.1.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(
    name = "go_sdk",
    version = "1.25.0",
)
use_repo(go_sdk, "go_sdk")

rust_toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
rust_toolchains.toolchain(
    edition = "2024",
    version = "1.97.1",
)
use_repo(rust_toolchains, "default_rust_toolchains")
register_toolchains(
    "@default_rust_toolchains//:all",
    "@llvm//toolchain:all",
)

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lock = "//bazel/itest:Cargo.lock",
    cargo_toml = "//bazel/itest:Cargo.toml",
    platform_triples = ["x86_64-unknown-linux-gnu"],
)
use_repo(crate, "crates")

corpus_images = use_extension("//bazel:oci_deps.bzl", "oci_deps")
use_repo(
    corpus_images,
    "aiohttp_realworld",
    "aiohttp_realworld_linux_amd64",
    "django_ninja_realworld",
    "django_ninja_realworld_linux_amd64",
    "hurl_tool",
    "hurl_tool_linux_amd64",
    "otel_python",
    "otel_python_linux_amd64",
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "realworld_api_specs",
    build_file_content = """
package(default_visibility = ["//visibility:public"])

filegroup(
    name = "hurl_all",
    srcs = glob(["hurl/*.hurl"]),
)

""",
    sha256 = "a020323e935d1185e8f8a6f64317e6346b44cb0b037d991ec45df89fb7a12adc",
    strip_prefix = "realworld-5d510ce6ec41bb97723e92fbd8d3e3458a381c09/specs/api",
    urls = ["https://github.com/realworld-apps/realworld/archive/5d510ce6ec41bb97723e92fbd8d3e3458a381c09.tar.gz"],
)
