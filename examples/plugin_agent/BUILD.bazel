# Re-export the controlled native emitter check so an external module verifies
# that a consumer-declared tracer identity is accepted and a mismatch rejected.
test_suite(
    name = "datadog_consumer_identity_test",
    tests = ["@rules_stests//corpus:datadog_conformance_test"],
)

telemetry_api_check(
    name = "telemetry_api_check",
