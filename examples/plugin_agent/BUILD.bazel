    implementation_libraries = ["@rules_stests//corpus:datadog/implementation/python-v4.14.0.scm"],
    wire_version = "v0.5",
    reference_profile = "@rules_stests//corpus:python-aiohttp-datadog-v4-14-0-v05",
)

corpus_service(
    name = "example_datadog_service",
