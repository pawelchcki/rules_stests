external_feature_tests()
datadog_external_feature_tests()
datadog_parallel_tests()

_PYTHON_ARGS = ["--host", "127.0.0.1", "--port", "$${PORT}"]
_PYTHON_ENV = otlp_env(extra = {
    "OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED": "true",
})
