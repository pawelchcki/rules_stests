"""Reference applications and their exact OpenTelemetry contract tests."""

load("//bazel:oci_images.lock.bzl", "RUBY_IMAGES_PUBLISHED")
load("//rules:realworld_app.bzl", "otel_variant", "otlp_env", "python_auto_injection", "realworld_app_suite", "ruby_auto_injection")
load("//rules:otel_profile.bzl", "otel_report_manifest")

package(default_visibility = ["//visibility:public"])

_PYTHON_ENV = otlp_env(extra = {
    "OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED": "true",
})

realworld_app_suite(
    name = "aiohttp",
    app = "aiohttp",
    env = _PYTHON_ENV,
    injection = python_auto_injection(),
    plain = True,
    profile = "//corpus:python-aiohttp-auto-v0-65b0",
)

realworld_app_suite(
    name = "django",
    app = "django",
    env = _PYTHON_ENV,
    injection = python_auto_injection(),
    plain = True,
    profile = "//corpus:python-django-auto-v0-65b0",
    variants = {
        "propagators-b3": otel_variant(
            profile = "//corpus:python-django-auto-v0-65b0-propagators-b3",
            env = {"OTEL_PROPAGATORS": "b3multi"},
            scenarios = ["propagation_b3"],
        ),
        "temporality-delta": otel_variant(
            profile = "//corpus:python-django-auto-v0-65b0-temporality-delta",
            env = {"OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE": "delta"},
            scenarios = ["tags"],
        ),
    },
)

realworld_app_suite(
    name = "rails",
    app = "rails",
    env = otlp_env(
        metrics = False,
        per_signal_endpoints = True,
        extra = {
            "OTEL_EXPORTER_OTLP_COMPRESSION": "none",
            "OTEL_RUBY_ENABLED_INSTRUMENTATIONS": "rack,rails,action_pack,active_record",
        },
    ),
    injection = ruby_auto_injection(),
    plain = True,
    profile = "//corpus:ruby-rails-auto-v0-1-0",
)

# Gin's listener does not use SO_REUSEPORT, and its instrumentation is linked
# into a second binary in the same image rather than injected as a rootfs.
realworld_app_suite(
    name = "gin",
    app = "gin",
    env = otlp_env(
        logs = False,
        extra = {
            "OTEL_RESOURCE_ATTRIBUTES": "process.owner=nonroot",
        },
    ),
    plain = True,
    profile = "//corpus:go-gin-otelbuild-v1-1-0",
)

# Every language stays in the report regardless of image publication. A profile
# whose images are unpublished is declared unavailable, so report assembly
# accepts its lack of receipts while keeping its checked-in shapes and upstream
# claims visible. No feature of an unavailable profile can reach verified.
_REPORT_PROFILES = [
    "//corpus:go-gin-otelbuild-v1-1-0",
    "//corpus:python-aiohttp-auto-v0-65b0",
    "//corpus:python-django-auto-v0-65b0",
    "//corpus:python-django-auto-v0-65b0-propagators-b3",
    "//corpus:python-django-auto-v0-65b0-temporality-delta",
    "//corpus:ruby-rails-auto-v0-1-0",
]

test_suite(
    name = "otel_report_suite",
    tests = [
        ":aiohttp_otel_hurl_test",
        ":django_otel_hurl_test",
        ":django_propagators-b3_otel_hurl_test",
        ":django_temporality-delta_otel_hurl_test",
        ":gin_otel_hurl_test",
    ] + ([":rails_otel_hurl_test"] if RUBY_IMAGES_PUBLISHED else []),
)

otel_report_manifest(
    name = "otel_report_manifest",
    profiles = _REPORT_PROFILES,
    # This is an explicit owner declaration, not an inference from missing
    # receipts: an unexpected absent runner remains an assembly failure.
    unavailable_profiles = ["//corpus:ruby-rails-auto-v0-1-0"] if not RUBY_IMAGES_PUBLISHED else [],
)
