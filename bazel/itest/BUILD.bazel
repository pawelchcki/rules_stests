load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("@rules_itest//:itest.bzl", "itest_service", "service_test")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load(":hurl_test.bzl", "realworld_hurl_test_suite")
load(":oci_rootfs.bzl", "oci_rootfs")

package(default_visibility = ["//visibility:public"])

_OTEL_SINK_ENV = {
    "OTEL_BLRP_SCHEDULE_DELAY": "100",
    "OTEL_BSP_SCHEDULE_DELAY": "100",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://127.0.0.1:$${@@//bazel/itest:otel_sink_service}",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_METRIC_EXPORT_INTERVAL": "1000",
    "OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED": "true",
    "OTEL_TRACES_EXPORTER": "otlp",
}

rust_binary(
    name = "otel_sink",
    srcs = [
        "otel_sink/main.rs",
        "otel_sink/proto.rs",
        "otel_sink/scheme.rs",
        "otel_sink/validation.rs",
    ],
    aliases = aliases(),
    compile_data = [
        "@stak_compiler_assets//:compiler_bytecode",
        "@stak_compiler_assets//:prelude",
    ],
    edition = "2024",
    rustc_env = {
        "STAK_COMPILER_BYTECODE": "$(location @stak_compiler_assets//:compiler_bytecode)",
        "STAK_PRELUDE": "$(location @stak_compiler_assets//:prelude)",
    },
    rustc_flags = [
        "-Copt-level=2",
        "-Cpanic=abort",
        "-Clink-arg=-nostartfiles",
    ],
    deps = all_crate_deps(normal = True),
)

go_library(
    name = "otel_sink_probe_lib",
    srcs = ["otel_sink_probe.go"],
    importpath = "github.com/pawelchcki/rules_stests/bazel/itest/otel_sink_probe",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "otel_sink_probe",
    embed = [":otel_sink_probe_lib"],
)

itest_service(
    name = "otel_sink_service",
    args = [
        "--port",
        "$${PORT}",
        "--output",
        "$${TMPDIR}/otel-sink.json",
    ],
    autoassign_port = True,
    exe = ":otel_sink",
    http_health_check_address = "http://127.0.0.1:$${PORT}/healthz",
    shutdown_timeout = "2s",
)

service_test(
    name = "otel_sink_test",
    timeout = "short",
    args = ["--service-suffix=//bazel/itest:otel_sink_service"],
    services = [":otel_sink_service"],
    test = ":otel_sink_probe",
)

go_library(
    name = "oci_bundle_lib",
    srcs = ["oci_bundle.go"],
    importpath = "github.com/pawelchcki/rules_stests/bazel/itest/oci_bundle",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "oci_bundle",
    embed = [":oci_bundle_lib"],
)

go_library(
    name = "api_probe_lib",
    srcs = ["api_probe.go"],
    importpath = "github.com/pawelchcki/rules_stests/bazel/itest/api_probe",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "api_probe",
    embed = [":api_probe_lib"],
)

go_library(
    name = "hurl_test_driver_lib",
    srcs = ["hurl_test_driver.go"],
    importpath = "github.com/pawelchcki/rules_stests/bazel/itest/hurl_test_driver",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "realworld_hurl",
    data = [
        ":hurl_rootfs",
        "@realworld_api_specs//:hurl_all",
    ],
    embed = [":hurl_test_driver_lib"],
)

oci_rootfs(
    name = "aiohttp_rootfs",
    image = "@aiohttp_realworld_linux_amd64",
    single_payload = True,
)

oci_rootfs(
    name = "django_rootfs",
    image = "@django_ninja_realworld_linux_amd64",
    single_payload = True,
)

oci_rootfs(
    name = "hurl_rootfs",
    image = "@hurl_tool_linux_amd64",
)

oci_rootfs(
    name = "otel_python_rootfs",
    image = "@otel_python_linux_amd64",
)

itest_service(
    name = "aiohttp_service",
    args = [
        "app",
        "aiohttp",
        "$(rootpath :aiohttp_rootfs)",
        "serve",
        "--host",
        "127.0.0.1",
        "--port",
        "$${PORT}",
    ],
    autoassign_port = True,
    data = [":aiohttp_rootfs"],
    exe = ":oci_bundle",
    expected_start_duration = "3s",
    http_health_check_address = "http://127.0.0.1:$${PORT}/api/tags",
    shutdown_timeout = "10s",
)

service_test(
    name = "aiohttp_test",
    timeout = "moderate",
    args = ["--service-suffix=//bazel/itest:aiohttp_service"],
    services = [":aiohttp_service"],
    test = ":api_probe",
)

realworld_hurl_test_suite(
    name = "aiohttp_hurl_test",
    timeout = "moderate",
    service = ":aiohttp_service",
)

itest_service(
    name = "aiohttp_otel_service",
    args = [
        "app-otel",
        "aiohttp-otel",
        "$(rootpath :aiohttp_rootfs)",
        "$(rootpath :otel_python_rootfs)",
        "serve",
        "--host",
        "127.0.0.1",
        "--port",
        "$${PORT}",
    ],
    autoassign_port = True,
    data = [
        ":aiohttp_rootfs",
        ":otel_python_rootfs",
    ],
    env = _OTEL_SINK_ENV,
    exe = ":oci_bundle",
    expected_start_duration = "3s",
    http_health_check_address = "http://127.0.0.1:$${PORT}/api/tags",
    shutdown_timeout = "10s",
    deps = [":otel_sink_service"],
)

service_test(
    name = "aiohttp_otel_test",
    timeout = "moderate",
    args = ["--service-suffix=//bazel/itest:aiohttp_otel_service"],
    services = [":aiohttp_otel_service"],
    test = ":api_probe",
)

realworld_hurl_test_suite(
    name = "aiohttp_otel_hurl_test",
    timeout = "moderate",
    otel_app = "aiohttp",
    otel_sink = ":otel_sink_service",
    service = ":aiohttp_otel_service",
)

realworld_hurl_test_suite(
    name = "aiohttp_otel_contract_test",
    timeout = "moderate",
    otel_app = "aiohttp",
    otel_candidates = False,
    otel_exact = False,
    otel_sink = ":otel_sink_service",
    service = ":aiohttp_otel_service",
    tags = ["manual"],
)

itest_service(
    name = "django_service",
    args = [
        "app",
        "django",
        "$(rootpath :django_rootfs)",
        "serve",
        "--host",
        "127.0.0.1",
        "--port",
        "$${PORT}",
    ],
    autoassign_port = True,
    data = [":django_rootfs"],
    exe = ":oci_bundle",
    expected_start_duration = "3s",
    http_health_check_address = "http://127.0.0.1:$${PORT}/api/tags",
    shutdown_timeout = "10s",
)

service_test(
    name = "django_test",
    timeout = "moderate",
    args = ["--service-suffix=//bazel/itest:django_service"],
    services = [":django_service"],
    test = ":api_probe",
)

realworld_hurl_test_suite(
    name = "django_hurl_test",
    timeout = "moderate",
    service = ":django_service",
)

itest_service(
    name = "django_otel_service",
    args = [
        "app-otel",
        "django-otel",
        "$(rootpath :django_rootfs)",
        "$(rootpath :otel_python_rootfs)",
        "serve",
        "--host",
        "127.0.0.1",
        "--port",
        "$${PORT}",
    ],
    autoassign_port = True,
    data = [
        ":django_rootfs",
        ":otel_python_rootfs",
    ],
    env = _OTEL_SINK_ENV,
    exe = ":oci_bundle",
    expected_start_duration = "3s",
    http_health_check_address = "http://127.0.0.1:$${PORT}/api/tags",
    shutdown_timeout = "10s",
    deps = [":otel_sink_service"],
)

service_test(
    name = "django_otel_test",
    timeout = "moderate",
    args = ["--service-suffix=//bazel/itest:django_otel_service"],
    services = [":django_otel_service"],
    test = ":api_probe",
)

realworld_hurl_test_suite(
    name = "django_otel_hurl_test",
    timeout = "moderate",
    otel_app = "django",
    otel_sink = ":otel_sink_service",
    service = ":django_otel_service",
)

realworld_hurl_test_suite(
    name = "django_otel_contract_test",
    timeout = "moderate",
    otel_app = "django",
    otel_candidates = False,
    otel_exact = False,
    otel_sink = ":otel_sink_service",
    service = ":django_otel_service",
    tags = ["manual"],
)
