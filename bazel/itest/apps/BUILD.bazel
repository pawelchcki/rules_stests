# Ruby app and agent images are intentionally manual while their immutable
# publication locks contain the all-zero sentinel. The publish workflows remove
# this gate only after anonymous-pull and single-payload verification succeeds.
_RUBY_MANUAL = [] if RUBY_IMAGES_PUBLISHED else ["manual"]

_RUBY_OTEL_SINK_ENV = {
    "OTEL_BLRP_SCHEDULE_DELAY": "100",
    "OTEL_BSP_SCHEDULE_DELAY": "100",
    "OTEL_EXPORTER_OTLP_COMPRESSION": "none",
    "OTEL_EXPORTER_OTLP_LOGS_ENDPOINT": "http://127.0.0.1:$${@@//bazel/itest:otel_sink_service}/v1/logs",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
    "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT": "http://127.0.0.1:$${@@//bazel/itest:otel_sink_service}/v1/traces",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_METRICS_EXPORTER": "none",
    "OTEL_RUBY_ENABLED_INSTRUMENTATIONS": "rack,rails,action_pack,active_record",
    "OTEL_TRACES_EXPORTER": "otlp",
}

oci_rootfs(
    name = "rails_rootfs",
    image = "@rails_realworld_linux_amd64",
    single_payload = True,
    tags = _RUBY_MANUAL,
