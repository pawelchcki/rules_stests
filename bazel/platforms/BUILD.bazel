package(default_visibility = ["//visibility:public"])

# Execution platform for the self-hosted BuildBuddy executor fleet. The workers
# register with `default_isolation_type: none`, so no container-image is set:
# actions run bare on the host. Every test in this repo launches its apps as
# plain processes from extracted OCI rootfs runfiles, so bare isolation is
# enough and nothing needs docker on the executor.
platform(
    name = "rbe_linux_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    exec_properties = {
        "Arch": "amd64",
        "OSFamily": "Linux",
        "Pool": "linux-amd64-kvm",
        "use-self-hosted-executors": "true",
    },
)
