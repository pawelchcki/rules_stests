package(default_visibility = ["//visibility:public"])

# Public repositories use BuildBuddy-managed executors. Tests launch apps as
# plain processes from extracted OCI rootfs runfiles and need no host services.
platform(
    name = "rbe_linux_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    exec_properties = {
        "Arch": "amd64",
        "OSFamily": "Linux",
        "container-image": "docker://docker.io/library/ubuntu@sha256:019e8eb29a85e74d64925745884f2ec79aa27e3feab36353d24656f4d6b89467",
        "use-self-hosted-executors": "false",
    },
)
