common --enable_bzlmod

# Remote execution is on by default: every action, tests included, runs on the
# self-hosted BuildBuddy executor fleet (pool linux-amd64-kvm). The API key is
# never stored in this repo — locally it comes from ~/.bazelrc
# (`common --remote_header=x-buildbuddy-api-key=...`) and in CI the BuildBuddy
# Workflow injects it. Use --config=local to opt out entirely.
common --bes_backend=grpcs://remote.buildbuddy.io
common --bes_results_url=https://pawel.buildbuddy.io/invocation/
common --remote_cache=grpcs://remote.buildbuddy.io
common --remote_executor=grpcs://remote.buildbuddy.io
common --remote_timeout=10m
common --remote_download_outputs=minimal
common --remote_local_fallback=false
common --remote_upload_local_results=false
common --spawn_strategy=remote
common --jobs=100
common --extra_execution_platforms=//bazel/platforms:rbe_linux_amd64
common --host_platform=//bazel/platforms:rbe_linux_amd64

test --test_output=errors

# Escape hatch: fully local, sandboxed, offline-capable builds.
common:local --remote_executor= --remote_cache= --bes_backend=
common:local --spawn_strategy=sandboxed,local
common:local --extra_execution_platforms= --host_platform=@platforms//host
common:local --jobs=auto

# CI-only add-on. The cache and executor flags above already apply everywhere;
# this config now only marks the invocation publicly visible. Keep the name:
# tools/assemble_otel_report.sh passes it via REPORT_BAZEL_CONFIG.
build:buildbuddy --build_metadata=VISIBILITY=PUBLIC
