load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("//corpus:registry.bzl", "DATADOG_SHAPE_LIBRARIES", "datadog_library_args", "datadog_library_labels")

package(default_visibility = ["//visibility:public"])

sh_test(
    name = "benchmark_datadog_test",
    srcs = ["benchmark_datadog_test.sh"],
    data = [
        "benchmark_datadog.py",
        "benchmark_datadog_test.py",
    ],
)

sh_binary(
    name = "assemble_otel_report",
    srcs = ["assemble_otel_report.sh"],
)

sh_test(
    name = "local_oci_repository_test",
    srcs = ["local_oci_repository_test.sh"],
    data = [
        "build_datadog_fixtures.sh",
        "local_oci_repository.py",
        "local_oci_repository_test.py",
    ],
)

py_library(
    name = "datadog_shapes_lib",
    srcs = ["datadog_shapes.py"],
    imports = ["."],
)

# Renders sink shape candidates in the readable vocabulary of corpus/datadog/shape.
py_binary(
    name = "datadog_shapes",
    srcs = ["datadog_shapes.py"],
    main = "datadog_shapes.py",
)

# The shape vocabulary and the libraries it depends on.
_SHAPE_VOCABULARY = ["telemetry/contract-error.scm", "datadog/capture/base.scm"] + DATADOG_SHAPE_LIBRARIES

py_test(
    name = "datadog_shapes_test",
    size = "medium",
    srcs = ["datadog_shapes_test.py"],
    main = "datadog_shapes_test.py",
    args = [
        "$(rootpath //harness:telemetry_sink)",
        "corpus/datadog/realworld/shape",
    ] + datadog_library_args(_SHAPE_VOCABULARY),
    data = [
        "//corpus:datadog_reviewed_shapes",
        "//harness:telemetry_sink",
    ] + datadog_library_labels(_SHAPE_VOCABULARY) + glob(["testdata/datadog_candidates/**"]),
    deps = [":datadog_shapes_lib"],
)
