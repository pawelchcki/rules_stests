(define-library (datadog profile)
  (export realworld-profile id display-name language framework implementation compose
          family wire-version application shape-namespace service-name signals
          tracer-version
          all scenario observed validate-profile)
  (import (scheme base) (scheme write) (datadog capture shapes)
          (datadog proofs) (datadog trace-shape) (realworld scenarios))
  (begin
(define (id value) (list 'id value))
(define (display-name value) (list 'display-name value))
(define (language value) (list 'language value))
(define (framework value) (list 'framework value))
(define (implementation value) (list 'implementation value))
(define (compose . values) (cons 'composition values))
(define (family value) (list 'family value))
(define (wire-version value) (list 'wire-version value))
(define (application value) (list 'application value))
(define (shape-namespace value) (list 'shape-namespace value))
(define (service-name value) (list 'service-name value))
(define (tracer-version value) (list 'tracer-version value))
(define (signals . values) (list 'signals values))
(define (observed . features) (list 'observed features))
(define (all proof) (list 'claim 'all proof))
(define (scenario name proof) (list 'claim (list name) proof))
(define (realworld-profile . clauses) (cons 'realworld-profile clauses))
(define (profile-field profile key) (field key (cdr profile)))

(define (validate-proofs profile scenario-name capture)
  (for-each
    (lambda (clause)
      (if (and (pair? clause) (eq? (car clause) 'claim)
               (or (eq? (cadr clause) 'all) (memq scenario-name (cadr clause))))
          (for-each
            (lambda (feature)
              (let ((rule (proof-rule feature)))
                (check rule (string-append "unknown Datadog feature " feature))
                (let ((shape (field 'assertion (cdr rule))))
                  (assert-capture-shape feature shape capture)
                  (display "[[DATADOG-PROOF-V2|") (display feature)
                  (display "|") (display shape) (display "|observed]]\n"))))
            (cadr (car (cddr clause))))
          #t))
    (cdr profile)))

(define (count predicate values)
  (let loop ((values values) (result 0))
    (if (null? values) result
        (loop (cdr values) (if (predicate (car values)) (+ result 1) result)))))
(define (sum counts) (if (null? counts) 0 (+ (car counts) (sum (cdr counts)))))
(define (http-bucket? span method status)
  (and (web-span? span) (equal? (tag span "http.method") method)
       (equal? (tag span "http.status_code") (number->string status))))
(define (validate-http-counts scenario-name capture)
  (let ((expected (expected-http-requests-for scenario-name))
        (spans (items capture 'spans)))
    (check (= (count web-span? spans) (sum (map car expected)))
           "Datadog server request count differs from scenario")
    ; Method/status counts bind HTTP classification independently of the exact
    ; reviewed native route/resource trees (which check the route dimension).
    (for-each
      (lambda (bucket)
        (let ((method (cadr bucket)) (status (cadr (cddr bucket))))
          (check (= (count (lambda (span) (http-bucket? span method status)) spans)
                    (sum (map (lambda (other)
                                (if (and (equal? method (cadr other)) (= status (cadr (cddr other))))
                                    (car other) 0)) expected)))
                 "Datadog HTTP method/status multiplicity differs from scenario")))
      expected)))

(define (validate-profile profile scenario-name capture validation-mode)
  (check (eq? (field 'protocol capture) 'datadog) "expected native Datadog capture")
  (check (eq? (field 'semantic-valid capture) #t) "Datadog capture contains semantic violations")
  (check (every (lambda (request)
                  (equal? (field 'wire-version request) (profile-field profile 'wire-version)))
                (items capture 'requests)) "Datadog intake wire version differs from profile")
  (check (every (lambda (request)
                  (and (equal? (header-value request "datadog-meta-lang")
                               (symbol->string (profile-field profile 'language)))
                       (equal? (header-value request "datadog-meta-tracer-version")
                               (profile-field profile 'tracer-version))))
                (items capture 'requests)) "Datadog tracer identity differs from profile")
  (check (every (lambda (span)
                  (or (not (web-span? span))
                      (equal? (field 'service span) (profile-field profile 'service-name))))
                (items capture 'spans)) "Datadog HTTP service identity differs from profile")
  (validate-http-counts scenario-name capture)
  (validate-proofs profile scenario-name capture)
  (if (and (pair? validation-mode) (eq? (car validation-mode) 'exact))
      (datadog-validate-trace-shapes (cdr validation-mode) capture)
      #t))
  ))
