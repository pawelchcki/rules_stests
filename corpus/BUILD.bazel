load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//corpus:defs.bzl", "REALWORLD_HURL_CASES")
load("//corpus:profile.bzl", "otel_profile", "otel_standard_registry")

package(default_visibility = ["//visibility:public"])

exports_files(glob(["**/*.scm"]))

go_binary(
    name = "standard_registry_generator",
    srcs = ["report/registry/main.go"],
    deps = [":feature_parity_lib"],
)

go_binary(
    name = "profile_plan_compiler",
    srcs = ["report/profilecmd/main.go"],
    deps = [":feature_parity_lib"],
)

otel_standard_registry(
    name = "otel_standard_registry",
    matrix = "report/data/spec-compliance-matrix.md",
    metadata = "report/data/catalog.json",
)

filegroup(
    name = "otel_standard_registry_json",
    srcs = [":otel_standard_registry"],
    output_group = "registry",
)

_PYTHON_IMPLEMENTATION_LAYERS = [
    "otel/implementations/python-sdk-v1.44.0.scm",
    "otel/implementations/python-auto-v0.65b0.scm",
]

otel_profile(
    name = "python_aiohttp_profile",
    profile_id = "python-aiohttp-auto-v0-65b0",
    specification = "realworld/profiles/python-aiohttp-auto-v0-65b0.scm",
    implementation_libraries = _PYTHON_IMPLEMENTATION_LAYERS + ["otel/implementations/aiohttp-v0.65b0.scm"],
    runtime_libraries = ["realworld/profiles/python.scm"],
    scenarios = REALWORLD_HURL_CASES,
    scenario_shapes = {
        "realworld/shapes/python-aiohttp-auto-v0-65b0/{}/shape.scm".format(scenario): scenario
        for scenario in REALWORLD_HURL_CASES
    },
    signals = ["traces", "metrics", "logs"],
    standard_registry = ":otel_standard_registry",
)

filegroup(
    name = "python_aiohttp_proof_plan",
    srcs = [":python_aiohttp_profile"],
    output_group = "proof_plan",
)

otel_profile(
    name = "python_django_profile",
    profile_id = "python-django-auto-v0-65b0",
    specification = "realworld/profiles/python-django-auto-v0-65b0.scm",
    implementation_libraries = _PYTHON_IMPLEMENTATION_LAYERS + ["otel/implementations/django-v0.65b0.scm"],
    runtime_libraries = ["realworld/profiles/python.scm"],
    scenarios = REALWORLD_HURL_CASES,
    scenario_shapes = {
        "realworld/shapes/python-django-auto-v0-65b0/{}/shape.scm".format(scenario): scenario
        for scenario in REALWORLD_HURL_CASES
    },
    signals = ["traces", "metrics", "logs"],
    standard_registry = ":otel_standard_registry",
)

filegroup(
    name = "python_django_proof_plan",
    srcs = [":python_django_profile"],
    output_group = "proof_plan",
)

otel_profile(
    name = "go_gin_profile",
    profile_id = "go-gin-otelbuild-v1-1-0",
    specification = "realworld/profiles/go-gin-otelbuild-v1-1-0.scm",
    implementation_libraries = [
        "otel/implementations/go-compile-v1.1.0.scm",
        "otel/implementations/go-runtime-v0.70.0.scm",
    ],
    runtime_libraries = ["realworld/profiles/go.scm"],
    scenarios = REALWORLD_HURL_CASES,
    signals = ["traces", "metrics"],
    standard_registry = ":otel_standard_registry",
)

filegroup(
    name = "go_gin_proof_plan",
    srcs = [":go_gin_profile"],
    output_group = "proof_plan",
)

config_setting(
    name = "cloudflared_linux_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "cloudflared_linux_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "cloudflared_darwin_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:osx",
    ],
)

config_setting(
    name = "cloudflared_darwin_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:osx",
    ],
)

config_setting(
    name = "cloudflared_windows_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
)

go_library(
    name = "feature_parity_lib",
    srcs = glob(
        ["report/report/*.go"],
        exclude = ["report/report/*_test.go"],
    ),
    importpath = "github.com/pawelchcki/rules_stests/corpus/report",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "feature_parity_generator",
    srcs = ["report/cmd/main.go"],
    deps = [":feature_parity_lib"],
)

go_test(
    name = "feature_parity_generator_test",
    srcs = [
        "report/cmd/main.go",
        "report/cmd/main_test.go",
    ],
    deps = [":feature_parity_lib"],
)

go_binary(
    name = "update_feature_catalog",
    srcs = ["report/updater/main.go"],
    tags = ["manual"],
    deps = [":feature_parity_lib"],
)

go_library(
    name = "feature_parity_http_server_lib",
    srcs = ["report/server/server.go"],
    importpath = "github.com/pawelchcki/rules_stests/corpus/report/server",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "feature_parity_http_server",
    srcs = ["report/server/cmd/main.go"],
    deps = [":feature_parity_http_server_lib"],
)

go_binary(
    name = "feature_parity_public_report",
    srcs = ["report/server/cmd/main.go"],
    args = select(
        {
            ":cloudflared_linux_amd64": ["--cloudflared=$(rootpath @cloudflared_linux_amd64//file)"],
            ":cloudflared_linux_arm64": ["--cloudflared=$(rootpath @cloudflared_linux_arm64//file)"],
            ":cloudflared_darwin_amd64": ["--cloudflared=$(rootpath @cloudflared_darwin_amd64//:cloudflared)"],
            ":cloudflared_darwin_arm64": ["--cloudflared=$(rootpath @cloudflared_darwin_arm64//:cloudflared)"],
            ":cloudflared_windows_amd64": ["--cloudflared=$(rootpath @cloudflared_windows_amd64//file)"],
        },
        no_match_error = "feature_parity_public_report supports Linux/macOS on x86-64/ARM64 and Windows on x86-64",
    ),
    data = select(
        {
            ":cloudflared_linux_amd64": ["@cloudflared_linux_amd64//file"],
            ":cloudflared_linux_arm64": ["@cloudflared_linux_arm64//file"],
            ":cloudflared_darwin_amd64": ["@cloudflared_darwin_amd64//:cloudflared"],
            ":cloudflared_darwin_arm64": ["@cloudflared_darwin_arm64//:cloudflared"],
            ":cloudflared_windows_amd64": ["@cloudflared_windows_amd64//file"],
        },
        no_match_error = "feature_parity_public_report supports Linux/macOS on x86-64/ARM64 and Windows on x86-64",
    ),
    deps = [":feature_parity_http_server_lib"],
)

go_test(
    name = "feature_parity_http_server_test",
    srcs = ["report/server/server_test.go"],
    embed = [":feature_parity_http_server_lib"],
)

go_test(
    name = "feature_parity_test",
    srcs = glob(["report/report/*_test.go"]),
    args = [
        "$(rootpath report/data/catalog.json)",
        "$(rootpath report/data/spec-compliance-matrix.md)",
        "$(rootpath :otel_standard_registry_json)",
        "$(rootpath :go_gin_proof_plan)",
        "$(rootpath :python_aiohttp_proof_plan)",
        "$(rootpath :python_django_proof_plan)",
        "$(rootpath realworld/profiles/go-gin-otelbuild-v1-1-0.scm)",
        "$(rootpath realworld/profiles/python-aiohttp-auto-v0-65b0.scm)",
        "$(rootpath realworld/profiles/python-django-auto-v0-65b0.scm)",
        "$(rootpath realworld/contract.scm)",
    ],
    data = [
        "report/data/catalog.json",
        "report/data/spec-compliance-matrix.md",
        ":otel_standard_registry_json",
        ":go_gin_proof_plan",
        ":python_aiohttp_proof_plan",
        ":python_django_proof_plan",
        "realworld/contract.scm",
        "realworld/profiles/go-gin-otelbuild-v1-1-0.scm",
        "realworld/profiles/python-aiohttp-auto-v0-65b0.scm",
        "realworld/profiles/python-django-auto-v0-65b0.scm",
    ],
    embed = [":feature_parity_lib"],
)

go_test(
    name = "update_feature_catalog_test",
    srcs = [
        "report/updater/main.go",
        "report/updater/main_test.go",
    ],
    deps = [":feature_parity_lib"],
)
