(define-library (otel trace-shape match)
  (export otel-validate-trace-shapes)
  (import (scheme base) (otel contract-error) (otel trace-shape explain))
  (begin

(define (capture-field key capture)
  (let ((entry (assq key capture)))
    (if entry (cadr entry) (contract-error "missing OTLP trace-shapes field"))))

(define (tagged tag value)
  (and (pair? value) (eq? (car value) tag)))

(define (part tag value)
  (let loop ((values (cdr value)))
    (cond ((null? values) #f)
          ((tagged tag (car values)) (car values))
          (else (loop (cdr values))))))

(define (string-prefix? prefix value)
  (and (<= (string-length prefix) (string-length value))
       (string=? prefix (substring value 0 (string-length prefix)))))

(define (string-suffix? suffix value)
  (let ((offset (- (string-length value) (string-length suffix))))
    (and (>= offset 0)
         (string=? suffix (substring value offset (string-length value))))))

(define (name-matches? matcher actual)
  (cond ((tagged 'one-of matcher)
         (let loop ((choices (cdr matcher)))
           (and (pair? choices)
                (or (name-matches? (car choices) actual)
                    (loop (cdr choices))))))
        ((not (string? actual)) (equal? matcher actual))
        ((string? matcher) (string=? matcher actual))
        ((tagged 'exact matcher) (string=? (cadr matcher) actual))
        ((tagged 'prefix-suffix matcher)
         (and (string-prefix? (cadr matcher) actual)
              (string-suffix? (car (cdr (cdr matcher))) actual)))
        (else #f)))

(define (property-matches? tag expected actual)
  (let ((wanted (part tag expected))
        (observed (part tag actual)))
    (or (not wanted)
        (and observed
             (if (eq? tag 'name)
                 (name-matches? (cadr wanted) (cadr observed))
                 (equal? (cadr wanted) (cadr observed)))))))

(define (node-matches? expected actual)
  (and (tagged 'span expected)
       (tagged 'span actual)
       (property-matches? 'scope expected actual)
       (property-matches? 'kind expected actual)
       (property-matches? 'status expected actual)
       (property-matches? 'name expected actual)
       (property-matches? 'http-status expected actual)
       (let ((wanted (part 'children expected))
             (observed (part 'children actual)))
         (if wanted
             (unordered-matches? (unordered-values (cadr wanted))
                                 (if observed (unordered-values (cadr observed)) '()))
             (or (not observed) (null? (unordered-values (cadr observed))))))))

(define (trace-matches? expected actual)
  (and (tagged 'trace expected)
       (tagged 'trace actual)
       (property-matches? 'coverage expected actual)
       (let ((wanted (part 'unordered expected))
             (observed (part 'unordered actual)))
         (and wanted observed
              (unordered-matches? (cdr wanted) (cdr observed))))))

(define (ordinary-matches? expected actual)
  (cond ((tagged 'trace expected) (trace-matches? expected actual))
        ((tagged 'span expected) (node-matches? expected actual))
        (else #f)))

(define (unordered-values value)
  (if (tagged 'unordered value) (cdr value) '()))

(define (prepend-copies count value tail)
  (if (= count 0) tail (prepend-copies (- count 1) value (cons value tail))))

(define (reverse-list values)
  (let loop ((values values) (result '()))
    (if (null? values)
        result
        (loop (cdr values) (cons (car values) result)))))

(define (try-counts minimum maximum value rest actual)
  (and (<= minimum maximum)
       (or (multiset-matches? (prepend-copies minimum value rest) actual)
           (try-counts (+ minimum 1) maximum value rest actual))))

(define (try-alternatives alternatives rest actual)
  (and (pair? alternatives)
       (or (multiset-matches? (cons (car alternatives) rest) actual)
           (try-alternatives (cdr alternatives) rest actual))))

(define (try-actual expected rest prefix remaining)
  (and (pair? remaining)
       (or (and (ordinary-matches? expected (car remaining))
                (multiset-matches? rest
                                   (append (reverse-list prefix) (cdr remaining))))
           (try-actual expected rest (cons (car remaining) prefix) (cdr remaining)))))

(define (multiset-matches? expected actual)
  (if (null? expected)
      (null? actual)
      (let ((item (car expected)) (rest (cdr expected)))
        (cond ((tagged 'repeat item)
               (and (integer? (cadr item))
                    (>= (cadr item) 0)
                    (multiset-matches? (prepend-copies (cadr item) (car (cdr (cdr item))) rest)
                                       actual)))
              ((tagged 'between item)
               (let ((minimum (cadr item))
                     (maximum (car (cdr (cdr item))))
                     (value (car (cdr (cdr (cdr item))))))
                 (and (integer? minimum) (integer? maximum)
                      (>= minimum 0) (>= maximum minimum)
                      (try-counts minimum maximum value rest actual))))
              ((tagged 'optional item)
               (try-counts 0 1 (cadr item) rest actual))
              ((tagged 'one-of item)
               (try-alternatives (cdr item) rest actual))
              (else (try-actual item rest '() actual))))))

(define (expand-actual values)
  (if (null? values)
      '()
      (let ((item (car values)) (rest (cdr values)))
        (if (tagged 'repeat item)
            (prepend-copies (cadr item)
                            (car (cdr (cdr item)))
                            (expand-actual rest))
            (cons item (expand-actual rest))))))

(define (unordered-matches? expected actual)
  (multiset-matches? expected (expand-actual actual)))

(define (otel-validate-trace-shapes expected capture)
  (let ((actual (capture-field 'trace-shapes capture)))
    (if (and (tagged 'traces expected)
             (tagged 'traces actual)
             (unordered-matches? (cdr expected) (cdr actual)))
        #t
        (trace-shape-mismatch expected actual tagged part property-matches? expand-actual))))
  ))
